// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistrationRequest {
  id          String             @id @default(cuid())
  email       String             @unique
  password    String
  name        String?
  status      RegistrationStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// Model for storing layout/UI settings
// This model is used by the page creation script to manage navigation visibility
model LayoutSettings {
  id                  String   @id @default(cuid())
  // Add new navigation visibility settings here when creating toggleable pages
  showBasicComponents Boolean  @default(true)
  showSaveReactComponents Boolean  @default(true)
  showSaveBasicComponents Boolean  @default(true)
  showDesignConcepts     Boolean  @default(true)
  showReactComponents    Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
