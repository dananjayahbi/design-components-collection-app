// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistrationRequest {
  id          String             @id @default(cuid())
  email       String             @unique
  password    String
  name        String?
  status      RegistrationStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// Model for storing Gemini text generation models
model TextModel {
  id          String   @id @default(cuid())
  name        String   // Display name
  modelId     String   @unique // Actual model ID used in API calls
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Model for storing Gemini image generation models
model ImageModel {
  id          String   @id @default(cuid())
  name        String   // Display name
  modelId     String   @unique // Actual model ID used in API calls
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Model for storing image generation settings
model ImageSettings {
  id                String   @id @default(cuid())
  defaultAspectRatio String  @default("3:4")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Model for storing layout/UI settings
model LayoutSettings {
  id                    String   @id @default(cuid())
  // Navigation visibility settings
  showGenerateContent   Boolean  @default(true)  showTest3             Boolean  @default(true)  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
