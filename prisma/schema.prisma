// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistrationRequest {
  id          String             @id @default(cuid())
  email       String             @unique
  password    String
  name        String?
  status      RegistrationStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// Model for storing layout/UI settings
// This model is used by the page creation script to manage navigation visibility
model LayoutSettings {
  id                  String   @id @default(cuid())
  // Add new navigation visibility settings here when creating toggleable pages
  showBasicComponents Boolean  @default(true)
  showSaveReactComponents Boolean  @default(true)
  showSaveBasicComponents Boolean  @default(true)
  showDesignConcepts     Boolean  @default(true)
  showReactComponents    Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Model for storing basic component code snippets
// Uses TEXT type to support very long code (1000+ lines)
model BasicComponent {
  id          String   @id @default(cuid())
  name        String   // Component name for identification
  description String?  // Optional description of the component
  html        String   @db.Text // HTML code
  css         String   @db.Text // CSS code
  javascript  String   @db.Text // JavaScript code
  tags        String[] // Tags for categorization
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
